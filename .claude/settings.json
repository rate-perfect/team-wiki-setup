{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-checkout.mjs\"",
            "timeout": 10,
            "statusMessage": "main-checkout guard"
          }
        ]
      }
    ]
  }
}
